{
    "name": "docker-scan",
    "version": "1.1.0",
    "description": "Scan filesystem directory for Dockerfiles and create metadata output.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/docker-scan.git"
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist/",
        ".github/assets"
    ],
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:js": "tsdown",
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:js",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:coverage": "npm test -- --coverage",
        "prepublishOnly": "npm run build",
        "lint": "eslint src AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix"
    },
    "keywords": [
        "docker",
        "image",
        "scan",
        "metadata",
        "groups"
    ],
    "license": "MIT",
    "devDependencies": {
        "@swc/core": "^1.7.26",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.5.1",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^7.0.3",
        "eslint": "^10.14.0",
        "rimraf": "^6.0.1",
        "tsdown": "^0.23.7",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "locter": "^2.1.1",
        "smob": "^1.5.0"
    }
}
